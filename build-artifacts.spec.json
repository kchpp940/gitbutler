{
  "version": "3.0.0",
  "description": "Unified build artifact specification for GitButler project - SINGLE SOURCE OF TRUTH",
  "notes": [
    "This spec is the single source of truth for ALL build output, cache, and temp locations.",
    "ALL scripts, configs, and build systems MUST derive their paths from this file.",
    "Dev/prod isolation is achieved via channel-specific subdirectories and CARGO_TARGET_DIR.",
    "Direct edits to paths in scripts/configs are FORBIDDEN - update this spec instead."
  ],
  "projectRoot": ".",
  "paths": {
    "targetRoot": "target",
    "targetTauri": "target/tauri",
    "targetRelease": "target/${TRIPLE}/release",
    "targetDebug": "target/${TRIPLE}/debug",
    "rustAnalyzer": "target/rust-analyzer",
    "desktopSource": "apps/desktop",
    "desktopBuild": "apps/desktop/build",
    "gitbutlerTauriCrate": "crates/gitbutler-tauri",
    "nodeModules": "node_modules",
    "pnpmStore": "node_modules/.pnpm",
    "turboCache": ".turbo",
    "turboCacheKey": "v3-${CHANNEL}-${PROFILE}",
    "viteCacheDefault": "node_modules/.vite",
    "viteCacheChanneled": "node_modules/.vite-${CHANNEL}"
  },
  "cargo": {
    "targetDir": "target",
    "defaultTargetDir": "target",
    "devTargetDir": "target/tauri",
    "releaseTargetDir": "target",
    "cargoConfigPath": ".cargo/config.toml",
    "expectedTargetDir": "target",
    "note": "CARGO_TARGET_DIR env var overrides .cargo/config.toml at build time; dev channel sets CARGO_TARGET_DIR=target/tauri"
  },
  "components": {
    "desktop": {
      "description": "Tauri desktop app (gitbutler-tauri binary)",
      "rustBinaryName": "gitbutler-tauri",
      "outputs": {
        "debug": "target/tauri/debug/gitbutler-tauri",
        "release": "target/${TRIPLE}/release/gitbutler-tauri"
      },
      "bundleOutput": "target/${TRIPLE}/release/bundle",
      "sourceDir": "crates/gitbutler-tauri"
    },
    "but": {
      "description": "CLI binary",
      "rustBinaryName": "but",
      "outputs": {
        "debug": "target/debug/but",
        "release": "target/${TRIPLE}/release/but"
      },
      "sourceDir": "crates/but"
    },
    "butServer": {
      "description": "Standalone API server",
      "rustBinaryName": "but-server",
      "outputs": {
        "debug": "target/debug/but-server",
        "release": "target/${TRIPLE}/release/but-server"
      },
      "sourceDir": "crates/but-server"
    },
    "gitbutlerGit": {
      "description": "Git askpass and git credentials helper",
      "rustBinaryName": "gitbutler-git-askpass",
      "outputs": {
        "debug": "target/debug/gitbutler-git-askpass",
        "release": "target/${TRIPLE}/release/gitbutler-git-askpass"
      },
      "sourceDir": "crates/gitbutler-git"
    },
    "sidecar": {
      "description": "Tauri sidecar binaries injected before bundling",
      "sourceDir": "target/${TRIPLE}/${PROFILE}",
      "injectDir": "crates/gitbutler-tauri",
      "binaries": {
        "askpass": "gitbutler-git-askpass",
        "but": "but"
      },
      "namingPatterns": [
        "gitbutler-git-askpass-${TRIPLE}",
        "but-${TRIPLE}"
      ],
      "windowsNamingPatterns": [
        "gitbutler-git-askpass-${TRIPLE}.exe",
        "but-${TRIPLE}.exe"
      ],
      "integrityManifest": ".sidecar-integrity.json",
      "requiredForChannels": ["nightly", "release"]
    },
    "frontend": {
      "description": "SvelteKit frontend static assets",
      "sourceDir": "apps/desktop",
      "outputDir": "apps/desktop/build",
      "buildManifest": ".build-manifest.json",
      "tempPatterns": [
        ".svelte-kit/**",
        "vite.config.ts.timestamp-*",
        "tsconfig.tsbuildinfo"
      ],
      "distPatterns": [
        "dist/**",
        "build/**"
      ]
    },
    "rust": {
      "description": "All Rust crates",
      "manifestPath": "target/.rust-binaries-manifest.json",
      "fixturePatterns": [
        "crates/*/tests/fixtures/generated-do-not-edit/**",
        "crates/*/tests/fixtures/generated-archives/**"
      ]
    },
    "e2e": {
      "description": "End-to-end test artifacts",
      "artifactPatterns": [
        "e2e/blackbox/videos/**",
        "e2e/**/test-results/**",
        "e2e/**/playwright-report/**"
      ]
    }
  },
  "channels": {
    "dev": {
      "profile": "debug",
      "targetDir": "target/tauri",
      "cargoTargetDir": "target/tauri",
      "bundle": false,
      "requiredBinaries": ["gitbutler-git-askpass", "but"]
    },
    "development": {
      "profile": "debug",
      "targetDir": "target/tauri",
      "cargoTargetDir": "target/tauri",
      "bundle": false,
      "requiredBinaries": ["gitbutler-git-askpass", "but"]
    },
    "nightly": {
      "profile": "release",
      "targetDir": "target",
      "cargoTargetDir": "target",
      "bundle": true,
      "requiredBinaries": ["gitbutler-git-askpass", "but", "gitbutler-tauri"]
    },
    "release": {
      "profile": "release",
      "targetDir": "target",
      "cargoTargetDir": "target",
      "bundle": true,
      "requiredBinaries": ["gitbutler-git-askpass", "but", "gitbutler-tauri"]
    },
    "production": {
      "profile": "release",
      "targetDir": "target",
      "cargoTargetDir": "target",
      "bundle": true,
      "requiredBinaries": ["gitbutler-git-askpass", "but", "gitbutler-tauri"]
    },
    "test": {
      "profile": "debug",
      "targetDir": "target",
      "cargoTargetDir": "target",
      "bundle": false,
      "requiredBinaries": ["gitbutler-git-askpass"]
    }
  },
  "cleanScopes": {
    "all": "Remove all build artifacts and caches",
    "rust": "Rust target dir, .rust-analyzer, fixtures",
    "node": "node_modules, turbo caches, vite caches",
    "frontend": "TS/JS build output, .svelte-kit, dist",
    "sidecar": "Tauri sidecar binaries and integrity manifest",
    "manifest": "All build manifest files",
    "fixtures": "Generated test fixtures only",
    "e2e": "E2E test artifacts",
    "cache": "Only caches (turbo, vite, rust-analyzer)",
    "dist": "Only distribution artifacts (target/*release, dist, build)"
  },
  "cleanRules": {
    "all": [
      "paths.targetRoot",
      "paths.rustAnalyzer",
      "paths.nodeModules",
      "paths.turboCache",
      "paths.viteCacheDefault",
      "paths.viteCacheChanneled",
      "components.frontend.outputDir",
      "components.frontend.tempPatterns",
      "components.sidecar.injectDir + \"/\" + components.sidecar.namingPatterns",
      "components.sidecar.injectDir + \"/\" + components.sidecar.integrityManifest",
      "components.rust.fixturePatterns",
      "components.e2e.artifactPatterns"
    ],
    "rust": [
      "paths.targetRoot",
      "paths.rustAnalyzer",
      "components.rust.fixturePatterns"
    ],
    "node": [
      "paths.nodeModules",
      "paths.turboCache",
      "paths.viteCacheDefault",
      "paths.viteCacheChanneled"
    ],
    "frontend": [
      "components.frontend.outputDir",
      "components.frontend.distPatterns",
      "components.frontend.tempPatterns",
      "paths.viteCacheDefault",
      "paths.viteCacheChanneled"
    ],
    "sidecar": [
      "components.sidecar.injectDir + \"/gitbutler-git-askpass-*\"",
      "components.sidecar.injectDir + \"/but-*\"",
      "components.sidecar.injectDir + \"/\" + components.sidecar.integrityManifest"
    ],
    "manifest": [
      "components.frontend.outputDir + \"/\" + components.frontend.buildManifest",
      "components.sidecar.injectDir + \"/\" + components.sidecar.integrityManifest",
      "components.rust.manifestPath"
    ],
    "fixtures": [
      "components.rust.fixturePatterns"
    ],
    "e2e": [
      "components.e2e.artifactPatterns"
    ],
    "cache": [
      "paths.turboCache",
      "paths.viteCacheDefault",
      "paths.viteCacheChanneled",
      "paths.rustAnalyzer"
    ],
    "dist": [
      "paths.targetRoot + \"/release\"",
      "paths.targetRoot + \"/debug\"",
      "components.frontend.outputDir"
    ]
  },
  "validation": {
    "strictMode": true,
    "failOnStaleArtifacts": true,
    "failOnMissingArtifacts": true,
    "failOnCacheMismatch": true,
    "mtimeGraceSeconds": 300,
    "artifactsMustExist": {
      "release": [
        "components.gitbutlerGit.outputs.release",
        "components.desktop.outputs.release",
        "components.sidecar.injectDir + \"/\" + components.sidecar.integrityManifest"
      ],
      "nightly": [
        "components.gitbutlerGit.outputs.release",
        "components.desktop.outputs.release",
        "components.sidecar.injectDir + \"/\" + components.sidecar.integrityManifest"
      ],
      "dev": [
        "components.frontend.outputDir + \"/\" + components.frontend.buildManifest"
      ],
      "development": [
        "components.frontend.outputDir + \"/\" + components.frontend.buildManifest"
      ]
    },
    "preBundleChecks": [
      "check_sidecar_integrity_manifest_exists",
      "check_sidecar_binaries_match_manifest",
      "check_sidecar_mtime_newer_than_git_commit",
      "check_frontend_manifest_channel_matches",
      "check_rust_manifest_channel_matches",
      "check_cargo_target_dir_consistency",
      "check_turbo_cache_key_matches_channel"
    ]
  },
  "tempFileNaming": {
    "prefix": "gitbutler-",
    "suffix": ".tmp",
    "pattern": "gitbutler-*.tmp",
    "runtimeSocketPattern": "gitbutler-askpass-*"
  }
}
